# Participant data. Nothing under here may ever reach the remote: the raw
# college records, the survey exports, and the SID-to-index linkage table are
# all directly or indirectly identifying.
data/
*.xlsx
*.xls
*.docx
anonymised_records.csv
raw_college_records.*
*linkage*
*_linkage.csv

# Manuscript drafts, ethics paperwork, questionnaires, and the reference
# thesis collection. These carry consent forms and third-party student work.
/proposal
/docs/*
/local

# Generated artefacts. Every one is reproducible with ./run.sh.
/results
*.pkl

# Environments
ml_env/
venv/
.env

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS noise
.DS_Store
Thumbs.db

# Tooling
.gstack/

# Explicit exceptions: documentation that is safe to publish and is tracked
# despite the /docs rule above.
!docs/E-XGBoost-technical-documentation.md
!docs/TODO.md
# Aggregate findings only. No record-level result, no identifier, no student
# name or index number appears anywhere in it.
!docs/disclosure-risk-findings.md

# The *linkage* rule above exists to keep the SID-to-index linkage table out of
# git. It also catches this analysis script by name. The script contains code,
# not data, so it is tracked.
!notebooks/06_linkage_attack.py
